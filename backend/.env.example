DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=sistema_agendamento
DB_SSLMODE=disable
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sistema_agendamento?sslmode=disable

# --- Cache & Filas Assíncronas (Redis & Asynq) ---
