# ==============================================================================
# Sistema de Agendamento — variáveis de ambiente (produção / VPS)
# Copie este arquivo para .env e ajuste os valores.
# O install.sh gera segredos automaticamente quando o valor é CHANGE_ME.
# NÃO versionar o arquivo .env.
# ==============================================================================

# Perfil Compose: "prod" sobe o Caddy (portas 80/443). Deixe vazio no desenvolvimento local.
COMPOSE_PROFILES=prod

# --- Domínio e HTTPS (Caddy / Let's Encrypt) ---
# Exemplo: app.seudominio.com.br
# Para instalar só em HTTP (IP, sem certificado): DOMAIN=:80  e HTTP_ONLY=true
DOMAIN=app.seudominio.com.br
ACME_EMAIL=admin@seudominio.com.br
HTTP_ONLY=false
CADDYFILE_PATH=./Caddyfile

# URL pública usada em documentação de webhooks (Asaas).
# Exemplo: https://app.seudominio.com.br
APP_PUBLIC_URL=https://app.seudominio.com.br
CORS_ORIGIN=https://app.seudominio.com.br

# Frontend (build-time). Em produção mantenha caminho relativo same-origin.
VITE_API_URL=/api/v1

# --- Aplicação ---
APP_ENV=production
PORT=8080
TZ=America/Sao_Paulo
SEED_DEMO=false
INITIAL_ADMIN_EMAIL=admin@plataforma.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sistema_agendamento
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=sistema_agendamento
DB_SSLMODE=disable

# --- Redis / Asynq ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Autenticação JWT ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN_HOURS=72

# --- Criptografia AES-256-GCM (64 caracteres hex = 32 bytes) ---
ENCRYPTION_KEY=CHANGE_ME

# --- Asaas (assinaturas). Substitua pelas chaves reais do painel. ---
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET=

# --- WUZAPI (WhatsApp) ---
WUZAPI_BASE_URL=http://wuzapi:8080
WUZAPI_ADMIN_TOKEN=CHANGE_ME
